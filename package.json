{
  "name": "family-vault",
  "productName": "family-vault",
  "version": "2.0.2",
  "private": true,
  "description": "My Electron application description",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "dev-saurabh-k",
    "email": "saurabhkumar.sakr@gmail.com"
  },
  "main": "./src/index.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "setup:ai": "node scripts/setup-ai.js",
    "eval:qa": "node scripts/evaluate-gemma-qa.js",
    "eval:qa:model": "node scripts/evaluate-gemma-qa.js --model",
    "sync:release": "node scripts/sync-release.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "echo \"No linting configured\""
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "onnxruntime-node": "^1.30.0",
    "pdf-parse": "^2.4.5",
    "ppu-paddle-ocr": "^6.6.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "config": {
    "forge": {
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "family-vault"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        }
      ]
    }
  }
}
